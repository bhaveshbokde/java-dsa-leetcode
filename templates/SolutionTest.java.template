        // does arithmetic. Several real bugs in this repository were found by
        // exactly this test.
    }

    @Test
    @DisplayName("matches a simple reference implementation on randomised inputs")
    void matchesReference() {
        // A fixed seed keeps failures reproducible. Never use an unseeded Random.
        Random random = new Random(12345L);
        for (int trial = 0; trial < 500; trial++) {
            int[] nums = new int[1 + random.nextInt(12)];
            for (int i = 0; i < nums.length; i++) {
                nums[i] = random.nextInt(21) - 10;
            }
            assertEquals(reference(nums), ClassName.solve(nums.clone()),
                    () -> "mismatch for " + Arrays.toString(nums));
        }
    }

    /**
     * Obviously-correct but slow implementation, used only as an oracle.
     * It may be O(n^2) or worse - the randomised inputs are kept small.
     */
